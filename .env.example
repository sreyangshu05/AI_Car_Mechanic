# ============================================
# AI Car Mechanic — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================

# --- Backend (Django) ---

# Django secret key (generate a new one for production)
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Durable database: leave empty for local SQLite. Set a PostgreSQL URL in production.
# DATABASE_URL=postgresql://username:password@host:5432/database

# Durable Neon Object Storage (S3-compatible). CLI-generated secrets must be copied
# to Render's secret environment settings; do not commit them in any .env file.
USE_NEON_OBJECT_STORAGE=False
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_STORAGE_BUCKET_NAME=car-mechanic-uploads
AWS_QUERYSTRING_AUTH=True
DATABASE_URL=postgresql://USER:NEW_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Alternative: AWS S3. Do not enable both storage backends simultaneously.
USE_S3_MEDIA=False
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are optional when using an attached IAM role.

# --- AI / Gemini ---

# OpenRouter API key (keep private; never expose it to the frontend)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AI Car Mechanic

# --- Frontend (Next.js) ---

# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
